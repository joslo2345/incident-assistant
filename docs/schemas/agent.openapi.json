{
  "components": {
    "schemas": {
      "ActionType": {
        "enum": [
          "none",
          "monitor",
          "reset_gpu",
          "drain_node",
          "replace_part",
          "escalate"
        ],
        "title": "ActionType",
        "type": "string"
      },
      "Citation": {
        "additionalProperties": false,
        "description": "Pointer to a knowledge-base chunk (A4) that supports a claim.",
        "properties": {
          "chunk_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Chunk Id",
            "type": "string"
          },
          "doc_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Doc Id",
            "type": "string"
          },
          "quote": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote"
          }
        },
        "required": [
          "chunk_id",
          "doc_id"
        ],
        "title": "Citation",
        "type": "object"
      },
      "ComponentKind": {
        "enum": [
          "gpu",
          "node",
          "fan",
          "psu",
          "nvlink",
          "pcie"
        ],
        "title": "ComponentKind",
        "type": "string"
      },
      "ComponentRef": {
        "additionalProperties": false,
        "properties": {
          "gpu_index": {
            "anyOf": [
              {
                "exclusiveMaximum": 16.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gpu Index"
          },
          "kind": {
            "$ref": "#/components/schemas/ComponentKind"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "e.g. \"FAN3\", \"PSU1\"",
            "title": "Name"
          },
          "node_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "title": "Node Id",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "node_id"
        ],
        "title": "ComponentRef",
        "type": "object"
      },
      "DecisionRequest": {
        "properties": {
          "decided_by": {
            "maxLength": 100,
            "minLength": 2,
            "pattern": "^[A-Za-z0-9._@ -]+$",
            "title": "Decided By",
            "type": "string"
          },
          "decision": {
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "required": [
          "decision",
          "decided_by"
        ],
        "title": "DecisionRequest",
        "type": "object"
      },
      "Diagnosis": {
        "additionalProperties": false,
        "description": "Structured output of the investigation agent.",
        "properties": {
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "model": {
            "description": "Model that produced the diagnosis",
            "maxLength": 128,
            "title": "Model",
            "type": "string"
          },
          "recommended_action": {
            "$ref": "#/components/schemas/RecommendedAction"
          },
          "root_cause": {
            "$ref": "#/components/schemas/FailureType"
          },
          "summary": {
            "maxLength": 4000,
            "title": "Summary",
            "type": "string"
          },
          "trace_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },
        "required": [
          "root_cause",
          "confidence",
          "summary",
          "recommended_action",
          "model",
          "created_at"
        ],
        "title": "Diagnosis",
        "type": "object"
      },
      "FailureType": {
        "description": "Root-cause categories shared by the fault injector, detector, and agent.",
        "enum": [
          "thermal_runaway",
          "ecc_degradation",
          "power_fault",
          "gpu_off_bus",
          "nvlink_degradation",
          "pcie_degradation",
          "noisy_neighbor",
          "unknown"
        ],
        "title": "FailureType",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "InvestigateResponse": {
        "properties": {
          "approval_request": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Request"
          },
          "cost_usd": {
            "title": "Cost Usd",
            "type": "number"
          },
          "diagnosis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Diagnosis"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "incident_id": {
            "format": "uuid",
            "title": "Incident Id",
            "type": "string"
          },
          "input_tokens": {
            "title": "Input Tokens",
            "type": "integer"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "output_tokens": {
            "title": "Output Tokens",
            "type": "integer"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "steps": {
            "title": "Steps",
            "type": "integer"
          },
          "tool_calls": {
            "title": "Tool Calls",
            "type": "integer"
          }
        },
        "required": [
          "run_id",
          "incident_id",
          "status",
          "diagnosis",
          "approval_request",
          "provider",
          "model",
          "steps",
          "tool_calls",
          "input_tokens",
          "output_tokens",
          "cost_usd",
          "latency_ms",
          "error"
        ],
        "title": "InvestigateResponse",
        "type": "object"
      },
      "RecommendedAction": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/components/schemas/ActionType"
          },
          "rationale": {
            "maxLength": 2000,
            "title": "Rationale",
            "type": "string"
          },
          "target": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ComponentRef"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "action",
          "rationale"
        ],
        "title": "RecommendedAction",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Investigates incidents with tools and returns cited diagnoses. State-changing actions become approval requests that a person decides.",
    "title": "Incident Assistant: Agent API",
    "version": "1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness check"
      }
    },
    "/v1/approvals": {
      "get": {
        "operationId": "list_approvals_v1_approvals_get",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "pending",
                    "approved",
                    "rejected"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response List Approvals V1 Approvals Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Approval requests, newest first"
      }
    },
    "/v1/approvals/{request_id}/decision": {
      "post": {
        "operationId": "decide_v1_approvals__request_id__decision_post",
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Request Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Decide V1 Approvals  Request Id  Decision Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Approve or reject a request"
      }
    },
    "/v1/incidents/{incident_id}/diagnosis": {
      "get": {
        "operationId": "latest_diagnosis_v1_incidents__incident_id__diagnosis_get",
        "parameters": [
          {
            "in": "path",
            "name": "incident_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Incident Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Latest Diagnosis V1 Incidents  Incident Id  Diagnosis Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Latest successful diagnosis"
      }
    },
    "/v1/incidents/{incident_id}/investigate": {
      "post": {
        "operationId": "run_investigation_v1_incidents__incident_id__investigate_post",
        "parameters": [
          {
            "in": "path",
            "name": "incident_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Incident Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvestigateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Run an investigation now (blocks until it finishes)"
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "operationId": "get_run_v1_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Run V1 Runs  Run Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "A run with its full trace"
      }
    }
  }
}
