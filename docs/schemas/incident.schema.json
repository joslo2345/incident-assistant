{
  "$defs": {
    "ActionType": {
      "enum": [
        "none",
        "monitor",
        "reset_gpu",
        "drain_node",
        "replace_part",
        "escalate"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "Pointer to a knowledge-base chunk (A4) that supports a claim.",
      "properties": {
        "chunk_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "doc_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        }
      },
      "required": [
        "chunk_id",
        "doc_id"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ComponentKind": {
      "enum": [
        "gpu",
        "node",
        "fan",
        "psu",
        "nvlink",
        "pcie"
      ],
      "title": "ComponentKind",
      "type": "string"
    },
    "ComponentRef": {
      "additionalProperties": false,
      "properties": {
        "gpu_index": {
          "anyOf": [
            {
              "exclusiveMaximum": 16,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu Index"
        },
        "kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. \"FAN3\", \"PSU1\"",
          "title": "Name"
        },
        "node_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node_id"
      ],
      "title": "ComponentRef",
      "type": "object"
    },
    "DetectorKind": {
      "enum": [
        "static_threshold",
        "zscore",
        "event_match",
        "model"
      ],
      "title": "DetectorKind",
      "type": "string"
    },
    "Diagnosis": {
      "additionalProperties": false,
      "description": "Structured output of the investigation agent.",
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "model": {
          "description": "Model that produced the diagnosis",
          "maxLength": 128,
          "title": "Model",
          "type": "string"
        },
        "recommended_action": {
          "$ref": "#/$defs/RecommendedAction"
        },
        "root_cause": {
          "$ref": "#/$defs/FailureType"
        },
        "summary": {
          "maxLength": 4000,
          "title": "Summary",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        }
      },
      "required": [
        "root_cause",
        "confidence",
        "summary",
        "recommended_action",
        "model",
        "created_at"
      ],
      "title": "Diagnosis",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "One signal that contributed to the incident, with the window it was seen in.",
      "properties": {
        "component": {
          "$ref": "#/$defs/ComponentRef"
        },
        "description": {
          "maxLength": 1000,
          "title": "Description",
          "type": "string"
        },
        "detector": {
          "$ref": "#/$defs/DetectorKind"
        },
        "evidence_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "observed_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Value"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "z-score or model score, if any",
          "title": "Score"
        },
        "signal": {
          "description": "Metric or event name, e.g. \"temperature_c\"",
          "maxLength": 128,
          "title": "Signal",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "detector",
        "component",
        "signal",
        "window_start",
        "window_end",
        "description"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FailureType": {
      "description": "Root-cause categories shared by the fault injector, detector, and agent.",
      "enum": [
        "thermal_runaway",
        "ecc_degradation",
        "power_fault",
        "gpu_off_bus",
        "nvlink_degradation",
        "pcie_degradation",
        "noisy_neighbor",
        "unknown"
      ],
      "title": "FailureType",
      "type": "string"
    },
    "IncidentStatus": {
      "enum": [
        "open",
        "investigating",
        "diagnosed",
        "resolved",
        "dismissed"
      ],
      "title": "IncidentStatus",
      "type": "string"
    },
    "RecommendedAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionType"
        },
        "rationale": {
          "maxLength": 2000,
          "title": "Rationale",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action",
        "rationale"
      ],
      "title": "RecommendedAction",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "sev1",
        "sev2",
        "sev3",
        "sev4"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/ComponentRef"
      },
      "minItems": 1,
      "title": "Components",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "diagnosis": {
      "anyOf": [
        {
          "$ref": "#/$defs/Diagnosis"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "incident_id": {
      "format": "uuid",
      "title": "Incident Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "$ref": "#/$defs/IncidentStatus"
    },
    "suspected_failure_type": {
      "$ref": "#/$defs/FailureType",
      "default": "unknown"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "incident_id",
    "created_at",
    "updated_at",
    "status",
    "severity",
    "title",
    "components",
    "evidence"
  ],
  "title": "Incident",
  "type": "object"
}
