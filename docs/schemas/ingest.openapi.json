{
  "components": {
    "schemas": {
      "BmcEntryCode": {
        "description": "Redfish `EntryCode` for sensor entries: whether a condition started or cleared.",
        "enum": [
          "assert",
          "deassert"
        ],
        "title": "BmcEntryCode",
        "type": "string"
      },
      "BmcEntryType": {
        "description": "Redfish `EntryType`. `sel` entries are IPMI SEL records surfaced through Redfish.",
        "enum": [
          "event",
          "sel",
          "oem"
        ],
        "title": "BmcEntryType",
        "type": "string"
      },
      "BmcLogEvent": {
        "additionalProperties": false,
        "description": "A BMC log entry, normalized to the shape of a DMTF Redfish `LogEntry`.\n\n`timestamp` is the entry's Redfish `Created` time.",
        "properties": {
          "entry_code": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BmcEntryCode"
              },
              {
                "type": "null"
              }
            ]
          },
          "entry_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Redfish `Id` on the BMC",
            "title": "Entry Id"
          },
          "entry_type": {
            "$ref": "#/components/schemas/BmcEntryType"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "event_type": {
            "const": "bmc_log",
            "default": "bmc_log",
            "title": "Event Type",
            "type": "string"
          },
          "message": {
            "maxLength": 2000,
            "title": "Message",
            "type": "string"
          },
          "message_args": {
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "title": "Message Args",
            "type": "array"
          },
          "message_id": {
            "description": "Registry message ID, e.g. \"OpenBMC.0.1.SensorThresholdCriticalLowGoingLow\" or a vendor ID like \"PSU0003\"",
            "maxLength": 256,
            "minLength": 1,
            "title": "Message Id",
            "type": "string"
          },
          "node_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "title": "Node Id",
            "type": "string"
          },
          "reading": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reading"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "sensor_name": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "e.g. \"FAN3\", \"PSU1\"",
            "title": "Sensor Name"
          },
          "sensor_number": {
            "anyOf": [
              {
                "maximum": 255.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sensor Number"
          },
          "sensor_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BmcSensorType"
              },
              {
                "type": "null"
              }
            ]
          },
          "severity": {
            "$ref": "#/components/schemas/BmcSeverity"
          },
          "source_format": {
            "$ref": "#/components/schemas/BmcSourceFormat",
            "default": "redfish"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "unit": {
            "anyOf": [
              {
                "maxLength": 16,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "e.g. \"RPM\", \"Cel\", \"W\"",
            "title": "Unit"
          }
        },
        "required": [
          "event_id",
          "timestamp",
          "node_id",
          "entry_type",
          "severity",
          "message_id",
          "message"
        ],
        "title": "BmcLogEvent",
        "type": "object"
      },
      "BmcSensorType": {
        "description": "Subset of Redfish `SensorType` (the IPMI sensor types) relevant to GPU servers.",
        "enum": [
          "temperature",
          "voltage",
          "current",
          "fan",
          "power_supply",
          "power_unit",
          "processor",
          "memory",
          "critical_interrupt",
          "other"
        ],
        "title": "BmcSensorType",
        "type": "string"
      },
      "BmcSeverity": {
        "description": "Redfish `Severity`.",
        "enum": [
          "ok",
          "warning",
          "critical"
        ],
        "title": "BmcSeverity",
        "type": "string"
      },
      "BmcSourceFormat": {
        "description": "How the entry was collected before being normalized to this schema.",
        "enum": [
          "redfish",
          "ipmi_sel",
          "syslog"
        ],
        "title": "BmcSourceFormat",
        "type": "string"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Body for 4xx/5xx errors other than request validation (422).",
        "properties": {
          "error": {
            "description": "Machine-readable code, e.g. \"unauthorized\", \"overloaded\"",
            "title": "Error",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GpuMetricsEvent": {
        "additionalProperties": false,
        "properties": {
          "ecc_dbe_total": {
            "description": "Uncorrectable (double-bit) ECC errors",
            "minimum": 0.0,
            "title": "Ecc Dbe Total",
            "type": "integer"
          },
          "ecc_sbe_total": {
            "description": "Correctable (single-bit) ECC errors",
            "minimum": 0.0,
            "title": "Ecc Sbe Total",
            "type": "integer"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "event_type": {
            "const": "gpu_metrics",
            "default": "gpu_metrics",
            "title": "Event Type",
            "type": "string"
          },
          "gpu_index": {
            "exclusiveMaximum": 16.0,
            "minimum": 0.0,
            "title": "Gpu Index",
            "type": "integer"
          },
          "gpu_model": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "As DCGM reports it, e.g. \"NVIDIA H100 80GB HBM3\"",
            "title": "Gpu Model"
          },
          "gpu_uuid": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gpu Uuid"
          },
          "memory_temperature_c": {
            "anyOf": [
              {
                "maximum": 150.0,
                "minimum": -20.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Memory Temperature C"
          },
          "memory_total_mib": {
            "exclusiveMinimum": 0.0,
            "title": "Memory Total Mib",
            "type": "integer"
          },
          "memory_used_mib": {
            "minimum": 0.0,
            "title": "Memory Used Mib",
            "type": "integer"
          },
          "node_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "title": "Node Id",
            "type": "string"
          },
          "nvlink_crc_errors_total": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nvlink Crc Errors Total"
          },
          "pcie_replay_total": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pcie Replay Total"
          },
          "power_limit_w": {
            "exclusiveMinimum": 0.0,
            "maximum": 2000.0,
            "title": "Power Limit W",
            "type": "number"
          },
          "power_w": {
            "maximum": 2000.0,
            "minimum": 0.0,
            "title": "Power W",
            "type": "number"
          },
          "retired_pages_total": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retired Pages Total"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "sm_clock_mhz": {
            "maximum": 5000.0,
            "minimum": 0.0,
            "title": "Sm Clock Mhz",
            "type": "integer"
          },
          "temperature_c": {
            "maximum": 150.0,
            "minimum": -20.0,
            "title": "Temperature C",
            "type": "number"
          },
          "throttle_reasons": {
            "items": {
              "$ref": "#/components/schemas/ThrottleReason"
            },
            "title": "Throttle Reasons",
            "type": "array"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "utilization_pct": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Utilization Pct",
            "type": "number"
          }
        },
        "required": [
          "event_id",
          "timestamp",
          "node_id",
          "gpu_index",
          "temperature_c",
          "power_w",
          "power_limit_w",
          "utilization_pct",
          "memory_used_mib",
          "memory_total_mib",
          "sm_clock_mhz",
          "ecc_sbe_total",
          "ecc_dbe_total"
        ],
        "title": "GpuMetricsEvent",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "IngestResponse": {
        "additionalProperties": false,
        "description": "202 response for POST /v1/telemetry.",
        "properties": {
          "accepted": {
            "description": "Events queued for processing",
            "minimum": 0.0,
            "title": "Accepted",
            "type": "integer"
          },
          "duplicates": {
            "description": "Events skipped because their event_id was already seen",
            "minimum": 0.0,
            "title": "Duplicates",
            "type": "integer"
          }
        },
        "required": [
          "accepted",
          "duplicates"
        ],
        "title": "IngestResponse",
        "type": "object"
      },
      "TelemetryBatch": {
        "additionalProperties": false,
        "description": "Request body for POST /v1/telemetry.",
        "properties": {
          "events": {
            "items": {
              "discriminator": {
                "mapping": {
                  "bmc_log": "#/components/schemas/BmcLogEvent",
                  "gpu_metrics": "#/components/schemas/GpuMetricsEvent",
                  "xid": "#/components/schemas/XidEvent"
                },
                "propertyName": "event_type"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/GpuMetricsEvent"
                },
                {
                  "$ref": "#/components/schemas/XidEvent"
                },
                {
                  "$ref": "#/components/schemas/BmcLogEvent"
                }
              ]
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "title": "TelemetryBatch",
        "type": "object"
      },
      "ThrottleReason": {
        "description": "Subset of NVML clock-throttle reasons that matter for diagnosis.",
        "enum": [
          "sw_power_cap",
          "hw_slowdown",
          "hw_thermal_slowdown",
          "hw_power_brake_slowdown",
          "sw_thermal_slowdown"
        ],
        "title": "ThrottleReason",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "XidEvent": {
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "event_type": {
            "const": "xid",
            "default": "xid",
            "title": "Event Type",
            "type": "string"
          },
          "gpu_index": {
            "exclusiveMaximum": 16.0,
            "minimum": 0.0,
            "title": "Gpu Index",
            "type": "integer"
          },
          "message": {
            "maxLength": 2000,
            "title": "Message",
            "type": "string"
          },
          "node_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "title": "Node Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "xid_code": {
            "description": "NVIDIA XID error code, e.g. 79 = fell off bus",
            "maximum": 999.0,
            "minimum": 1.0,
            "title": "Xid Code",
            "type": "integer"
          }
        },
        "required": [
          "event_id",
          "timestamp",
          "node_id",
          "gpu_index",
          "xid_code",
          "message"
        ],
        "title": "XidEvent",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Accepts batched GPU telemetry: GPU metric samples, XID errors, and BMC log entries (Redfish LogEntry shape).",
    "title": "Incident Assistant: Telemetry Ingestion API",
    "version": "1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness check"
      }
    },
    "/v1/telemetry": {
      "post": {
        "description": "202 means every new event is durably stored in the stream.",
        "operationId": "ingest_telemetry_v1_telemetry_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid API key"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request body too large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Overloaded; retry after the number of seconds in Retry-After"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Stream unavailable; retry after the number of seconds in Retry-After"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Ingest a batch of telemetry events"
      }
    }
  }
}
